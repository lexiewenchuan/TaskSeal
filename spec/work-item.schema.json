{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lexiewenchuan/TaskSeal/main/spec/work-item.schema.json",
  "title": "TaskSeal Work Item",
  "description": "The canonical serialized contract emitted and consumed by the TaskSeal runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "goal",
    "requested_by",
    "resources",
    "acceptance",
    "risk",
    "risk_reasons",
    "prohibited_actions",
    "status",
    "plan",
    "authorizations",
    "artifacts",
    "evidence",
    "executor_ids",
    "next_action",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "risk_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "planning",
        "awaiting_authorization",
        "authorized",
        "executing",
        "verifying",
        "repairing",
        "blocked",
        "accepted",
        "cancelled"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan_step"
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorization"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "executor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": ["string", "null"]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "allowed_actions",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision": {
          "type": ["string", "null"]
        }
      }
    },
    "plan_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "status", "executor"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pending", "running", "completed", "failed", "skipped"]
        },
        "executor": {
          "type": ["string", "null"]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "resource_ids",
        "actions",
        "conditions",
        "expires_at",
        "granted_by",
        "status",
        "parent_authorization_id",
        "granted_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "resource_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "maxItems": 0,
          "description": "Reserved for future executable policy conditions."
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "granted_by": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["granted", "expired", "revoked"]
        },
        "parent_authorization_id": {
          "type": ["string", "null"]
        },
        "granted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "revision", "produced_by"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "produced_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "uri",
        "supports",
        "resource_revision",
        "collected_by",
        "observed_at",
        "details"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resource_revision": {
          "type": "string",
          "minLength": 1
        },
        "collected_by": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "required_evidence_kinds",
        "evidence_ids",
        "status",
        "verified_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": ["pending", "passed", "failed", "blocked"]
        },
        "verified_by": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
